# ==========================================================================
# CONFIGURAÇÕES DE AMBIENTE (.env / Cloudflare Workers Variables)
# ==========================================================================
# No painel da Cloudflare:
# Workers & Pages -> os-codigos-hebraicos-da-prosperidade -> Settings -> Variables and Secrets
# Adicione as variáveis abaixo:

# Link oficial do Checkout da Kiwify (obrigatório para redirecionamento de compra)
KIWIFY_CHECKOUT_URL="https://pay.kiwify.com.br/SEU_CODIGO_AQUI"

# Opcional: ID do Pixel da Meta (Facebook/Instagram Ads) para disparar PageView e InitiateCheckout
META_PIXEL_ID=""
